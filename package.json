{
  "name": "cinemaloop-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cinemaloop Cloud Functions: motor de juego, puntuación, historial y autenticación.",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:unit:watch": "vitest --config vitest.unit.config.mts",
    "test:integration": "firebase emulators:exec --project demo-cinemaloop --only firestore,auth \"vitest run --config vitest.integration.config.mts\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "emulators": "firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
