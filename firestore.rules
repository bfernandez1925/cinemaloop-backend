rules_version = '2';

// Deny-all por defecto (ver spec-auth.md, ADR-0001). Toda lectura y
// escritura pasa por Cloud Functions, que usan el Admin SDK y no están
// sujetas a estas reglas. El cliente nunca accede a Firestore directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
