# Claves de API usadas por las Cloud Functions. Nunca se exponen al cliente.
# En local, cargar en el emulador con `firebase functions:config:set` o un
# archivo .env consumido por firebase-functions/params (Secrets Manager en
# producción). Este proyecto no gestiona todavía entornos reales
# (desarrollo/staging/producción); estos valores son solo de referencia.

# TMDb: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Anthropic (Claude), usada en spec-ai-interpretation para normalizar respuestas.
ANTHROPIC_API_KEY=
